{
  "name": "island-of-the-dolls-short",
  "version": "1.0.0",
  "private": true,
  "description": "60s 9:16 YouTube Short: The Island of the Dolls — Plot Twist with A&R",
  "scripts": {
    "audio": "python3 scripts/make_audio.py",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render_twos.mjs --ones",
    "render:twos": "node scripts/render_twos.mjs",
    "render:api": "node scripts/render.mjs",
    "render:cli": "remotion render src/index.ts IslandOfTheDolls out/island-of-the-dolls-short.mp4",
    "still": "remotion still src/index.ts IslandOfTheDolls out/still.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
